;;; gptel-ui-clone-test.el --- Independent cloned views -*- lexical-binding: t; -*-

(require 'ert)
(require 'gptel-ui)

(defvar gptel-mode)
(defvar gptel-use-header-line)
(defvar gptel-prompt-prefix-alist)
(defvar gptel-response-prefix-alist)

(defun gptel-ui-clone-test--lifecycle (indirect)
  "Check source ownership through an ordinary or INDIRECT clone's lifecycle."
  (let ((source (generate-new-buffer " *ui-clone-source*"))
        (gptel-ui-refresh-delay 3600)
        clone)
    (unwind-protect
        (save-window-excursion
          (switch-to-buffer source)
          (text-mode)
          (setq-local gptel-mode t gptel-use-header-line t
                      gptel-prompt-prefix-alist '((text-mode . "@user\n"))
                      gptel-response-prefix-alist '((text-mode . "@assistant\n"))
                      header-line-format (list "Native" " Ready" '("Info")))
          (let ((filter (lambda (beg end delete)
                          (if delete (delete-and-extract-region beg end)
                            (buffer-substring beg end)))))
            (setq-local filter-buffer-substring-function filter)
            (face-remap-add-relative 'default '(:height 1.1))
            (push '(error . warning) face-remapping-alist)
            (insert "@user\nQuestion\n\n@assistant\n")
            (insert (propertize "Answer with [link](https://example.com).\n" 'gptel 'response))
            (gptel-ui-mode 1)
            (setq gptel-ui--expanded-reports (list "first" "second"))
            (setf (nth 1 header-line-format) " Streaming")
            (let ((overlays (copy-sequence gptel-ui--overlays))
                  (timer gptel-ui--timer)
                  (faces face-remapping-alist)
                  (face-snapshot (copy-tree face-remapping-alist))
                  (header header-line-format)
                  (native gptel-ui--native-header)
                  (source-filter filter-buffer-substring-function)
                  (hooks after-change-functions)
                  (margins gptel-ui--window-margins)
                  (reports gptel-ui--expanded-reports))
              (cl-labels
                  ((source-intact ()
                     (with-current-buffer source
                       (should gptel-ui-mode)
                       (should (equal overlays gptel-ui--overlays))
                       (dolist (overlay overlays)
                         (should (eq (overlay-buffer overlay) source)))
                       (should (eq gptel-ui--timer timer))
                       (should (memq timer timer-list))
                       (should (eq face-remapping-alist faces))
                       (should (equal face-remapping-alist face-snapshot))
                       (should (eq header-line-format header))
                       (should (equal (nth 1 header) " Streaming"))
                       (should (eq gptel-ui--native-header native))
                       (should (equal (nth 1 native) " Ready"))
                       (should (eq filter-buffer-substring-function source-filter))
                       (should (eq after-change-functions hooks))
                       (should (eq gptel-ui--window-margins margins))
                       (should (equal reports '("first" "second"))))))
                (setq clone (if indirect
                                (clone-indirect-buffer " *ui-clone-child*" nil)
                              (clone-buffer " *ui-clone-child*" nil)))
                (source-intact)
                (with-current-buffer clone
                  (should gptel-ui-mode)
                  (should gptel-ui--overlays)
                  (dolist (overlay gptel-ui--overlays)
                    (should (eq (overlay-buffer overlay) clone)))
                  (should-not (eq gptel-ui--timer timer))
                  (should-not (eq header-line-format header))
                  (should-not (eq gptel-ui--native-header native))
                  (should (equal (nth 1 header-line-format) " Streaming"))
                  (should-not gptel-ui--window-margins)
                  (should-not (eq gptel-ui--expanded-reports reports))
                  (setq gptel-ui--expanded-reports
                        (delete "second" gptel-ui--expanded-reports))
                  (setf (nth 1 header-line-format) " Clone ready")
                  (gptel-ui-refresh)
                  (let ((copy (filter-buffer-substring (point-min) (point-max))))
                    (should-not (text-property-not-all 0 (length copy) 'gptel nil copy))))
                (source-intact)
                (with-current-buffer clone
                  (gptel-ui-mode -1)
                  (should-not gptel-ui--overlays)
                  (should (eq filter-buffer-substring-function filter))
                  (should (equal (nth 1 header-line-format) " Clone ready")))
                (source-intact)
                (with-current-buffer clone (gptel-ui-mode 1))
                (should (kill-buffer clone))
                (source-intact)))))
      (when (buffer-live-p clone) (kill-buffer clone))
      (when (buffer-live-p source) (kill-buffer source)))))

(ert-deftest gptel-ui-clone-buffer-owns-its-presentation ()
  (gptel-ui-clone-test--lifecycle nil))

(ert-deftest gptel-ui-clone-indirect-buffer-owns-its-presentation ()
  (gptel-ui-clone-test--lifecycle t))

(ert-deftest gptel-ui-clone-source-view-can-enable-independent-decoration ()
  (with-temp-buffer
    (text-mode)
    (insert (propertize "A response.\n" 'gptel 'response))
    (gptel-ui-mode 1)
    (gptel-ui-toggle-source)
    (let ((clone (clone-buffer " *ui-source-clone*" nil))
          (timer gptel-ui--timer))
      (unwind-protect
          (progn
            (with-current-buffer clone
              (should gptel-ui--source)
              (gptel-ui-toggle-source)
              (should gptel-ui--overlays))
            (should gptel-ui--source)
            (should-not gptel-ui--overlays)
            (should (eq timer gptel-ui--timer)))
        (kill-buffer clone)))))

(provide 'gptel-ui-clone-test)
;;; gptel-ui-clone-test.el ends here
