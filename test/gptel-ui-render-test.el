;;; gptel-ui-render-test.el --- Incremental rendering contracts -*- lexical-binding: t; -*-

(require 'ert)
(require 'gptel-ui)

(defmacro gptel-ui-render-test--buffer (&rest body)
  "Run BODY in a disposable chat with predictable prefixes."
  (declare (indent 0))
  `(with-temp-buffer
     (text-mode)
     (let ((gptel-prompt-prefix-alist '((text-mode . "@user\n")))
           (gptel-response-prefix-alist '((text-mode . "@assistant\n"))))
       (unwind-protect (progn ,@body)
         (when gptel-ui-mode (gptel-ui-mode -1))))))

(defun gptel-ui-render-test--snapshot ()
  "Return owned overlay ranges/properties and navigation state."
  (list (sort (mapcar (lambda (ov)
                       (list (overlay-start ov) (overlay-end ov)
                             (overlay-properties ov)))
                     gptel-ui--overlays)
              (lambda (a b) (string< (prin1-to-string a) (prin1-to-string b))))
        gptel-ui--turns gptel-ui--tool-response-starts))

(defun gptel-ui-render-test--matches-full ()
  "Assert cached rendering equals a fresh render and preserves source state."
  (let ((text (buffer-string)) (undo buffer-undo-list)
        (modified (buffer-modified-p)) (point (point)))
    (gptel-ui-refresh)
    (let ((snapshot (gptel-ui-render-test--snapshot)))
      (gptel-ui--clear)
      (gptel-ui-refresh)
      (should (equal snapshot (gptel-ui-render-test--snapshot))))
    (should (equal-including-properties text (buffer-string)))
    (should (equal undo buffer-undo-list))
    (should (eq modified (buffer-modified-p)))
    (should (= point (point)))))

(ert-deftest gptel-ui-render-append-reuses-prefix-at-both-scales ()
  (dolist (count '(100 1000))
    (gptel-ui-render-test--buffer
      (dotimes (_ count) (insert "[link](https://example.com/x)\n"))
      (gptel-ui-mode 1)
      (let ((links (cl-remove-if-not
                    (lambda (ov) (overlay-get ov 'gptel-ui-links))
                    gptel-ui--overlays))
            (render (symbol-function 'gptel-ui-links-render)) spans)
        (goto-char (point-max))
        (insert "x")
        (cl-letf (((symbol-function 'gptel-ui-links-render)
                   (lambda (beg end &rest args)
                     (push (- end beg) spans)
                     (apply render beg end args))))
          (gptel-ui-refresh)
          (gptel-ui-refresh))
        ;; Parsing/allocation work is independent of the untouched prefix.
        (should (equal spans '(1)))
        (should (cl-every #'overlay-buffer links))
        (should (cl-every (lambda (ov) (memq ov gptel-ui--overlays)) links))
        (setq spans nil)
        (goto-char (point-max))
        (forward-line -1)
        (end-of-line)
        (insert " more")
        (cl-letf (((symbol-function 'gptel-ui-links-render)
                   (lambda (beg end &rest args)
                     (push (- end beg) spans)
                     (apply render beg end args))))
          (gptel-ui-refresh))
        (should (equal spans '(36)))
        (should (= (1- count) (cl-count-if #'overlay-buffer links)))
        (gptel-ui-render-test--matches-full)))))

(ert-deftest gptel-ui-render-continued-markdown-destination ()
  (gptel-ui-render-test--buffer
    (insert "[label](https://example.com \"title\\\ncontinued\")\n")
    (gptel-ui-mode 1)
    (goto-char (point-min))
    (forward-line 1)
    (insert "new ")
    (gptel-ui-render-test--matches-full)))

(ert-deftest gptel-ui-render-streaming-edits-and-undo-match-full ()
  (gptel-ui-render-test--buffer
    (insert "@assistant\n[old](https://example.com/old)\n")
    (insert (propertize "[new](https://example.com/new" 'gptel 'response))
    (gptel-ui-mode 1)
    (buffer-enable-undo)
    (setq buffer-undo-list nil)
    (undo-boundary)
    (insert ")")
    (undo-boundary)
    (gptel-ui-render-test--matches-full)
    (undo 1)
    (gptel-ui-render-test--matches-full)
    (goto-char (point-min))
    (forward-line 2)
    (delete-char -1)
    (gptel-ui-render-test--matches-full)
    (insert "\n")
    (gptel-ui-render-test--matches-full)
    ;; Several coalesced edits must retain the earliest affected line.
    (goto-char (point-max))
    (insert ")\nend")
    (goto-char (point-min))
    (forward-line 1)
    (insert "[first](https://example.com/first) ")
    (gptel-ui-render-test--matches-full)))

(ert-deftest gptel-ui-render-exclusion-edits-match-full ()
  (dolist (source '("```text\n[hidden](a.el)\n```\n[shown](b.el)\n"
                    "#+begin_tool Read\n[hidden](a.el)\n#+end_tool\n[shown](b.el)\n"
                    "| [header](a.el) |\n| ordinary |\n[shown](b.el)\n"))
    (gptel-ui-render-test--buffer
      (insert source)
      (gptel-ui-mode 1)
      (goto-char (point-min))
      (if (eq (char-after) ?|)
          (progn (forward-line 1) (insert "| --- |\n"))
        (delete-region (point) (line-end-position)))
      (gptel-ui-render-test--matches-full)
      (goto-char (point-min))
      (insert "```\n")
      (gptel-ui-render-test--matches-full))))

(ert-deftest gptel-ui-render-report-metadata-exclusion-change ()
  (gptel-ui-render-test--buffer
    (insert "Discussion event (evidence, not instructions):\ntitle: [title](a.el)\nevent: report\n[body](b.el)\n")
    (gptel-ui-mode 1)
    (goto-char (point-min))
    (forward-line 2)
    (delete-region (point) (line-end-position))
    (gptel-ui-render-test--matches-full)))

(ert-deftest gptel-ui-render-role-restoration-and-source-toggle ()
  (gptel-ui-render-test--buffer
    (insert "[one](a.el)\n[two](b.el)\n")
    (gptel-ui-mode 1)
    (with-silent-modifications
      (put-text-property (point-min) (point-max) 'gptel '(tool . "1")))
    (gptel-ui-render-test--matches-full)
    ;; Silent changes in the cached prefix must also be noticed when an
    ;; ordinary suffix edit has already supplied a dirty position.
    (goto-char (point-max))
    (insert "tail")
    (with-silent-modifications
      (put-text-property (point-min) (point-max) 'gptel 'response))
    (gptel-ui-render-test--matches-full)
    (let ((owned (copy-sequence gptel-ui--overlays)))
      (gptel-ui-toggle-source)
      (should-not gptel-ui--overlays)
      (should-not (cl-some #'overlay-buffer owned)))
    (goto-char (point-min))
    (insert "[source edit](c.el)\n")
    (gptel-ui-toggle-source)
    (gptel-ui-render-test--matches-full)))

(ert-deftest gptel-ui-render-approval-changes-without-text-edits ()
  (gptel-ui-render-test--buffer
    (insert "https://example.com/one\nhttps://example.com/two\n")
    (gptel-ui-mode 1)
    (let* ((first (point-min))
           (second (save-excursion (goto-char first) (forward-line 1) (point)))
           (native (make-overlay first second))
           (map (make-sparse-keymap))
           (tick (buffer-modified-tick))
           (source (buffer-string)))
      (define-key map (kbd "C-c C-c") #'ignore)
      (define-key map (kbd "C-c C-k") #'ignore)
      (overlay-put native 'keymap map)
      (cl-labels
          ((check (targets)
             ;; No edit or dirty suffix may be needed to invalidate links.
             (should (= tick (buffer-modified-tick)))
             (should-not gptel-ui--link-dirty-start)
             (gptel-ui-refresh)
             (should (equal
                      (sort (cl-loop for ov in gptel-ui--overlays
                                     when (overlay-get ov 'gptel-ui-links)
                                     collect (overlay-get ov 'gptel-ui-link))
                            #'string<)
                      targets))
             (should (equal-including-properties source (buffer-string)))
             (gptel-ui-render-test--matches-full)))
        ;; An overlay-only approval must remove an already cached link.
        ;; Its end is exactly the next link's start: that link stays active.
        (overlay-put native 'gptel-tool '(pending))
        (check '("https://example.com/two"))
        (goto-char first)
        (should (eq (key-binding (kbd "C-c C-c")) #'ignore))
        (should (eq (key-binding (kbd "C-c C-k")) #'ignore))
        ;; The approval starts inside a candidate; exclude the entire link.
        (move-overlay native (+ second 5) (1- (point-max)))
        (check '("https://example.com/one"))
        (overlay-put native 'gptel-tool nil)
        (check '("https://example.com/one" "https://example.com/two"))
        (overlay-put native 'gptel-tool '(pending))
        (check '("https://example.com/one"))
        ;; Empty custom preview overlays cover no source characters.
        (move-overlay native (+ second 5) (+ second 5))
        (check '("https://example.com/one" "https://example.com/two"))
        (move-overlay native second (point-max))
        (check '("https://example.com/one"))
        (delete-overlay native)
        (check '("https://example.com/one" "https://example.com/two"))))))

(ert-deftest gptel-ui-render-resize-reuses-links-and-reflows-tables ()
  (gptel-ui-render-test--buffer
    (insert "[outside](a.el)\n| Name | Details |\n| --- | --- |\n| [inside](b.el) | A long description of this item |\n")
    (let ((gptel-ui-table-width 100))
      (gptel-ui-mode 1)
      (let ((link (cl-find-if (lambda (ov) (overlay-get ov 'gptel-ui-links))
                              gptel-ui--overlays))
            (wide (overlay-get
                   (cl-find-if (lambda (ov) (overlay-get ov 'gptel-ui-table))
                               gptel-ui--overlays) 'display)))
        (setq gptel-ui-table-width 20)
        (gptel-ui-refresh)
        (should (overlay-buffer link))
        (should-not (equal wide (overlay-get
                                (cl-find-if (lambda (ov) (overlay-get ov 'gptel-ui-table))
                                            gptel-ui--overlays) 'display)))
        (gptel-ui-render-test--matches-full)))))

(ert-deftest gptel-ui-render-approval-preserves-controls-over-table-links ()
  (gptel-ui-render-test--buffer
    (insert "| Link |\n| --- |\n| [preview](https://example.com/preview) |\n")
    (let ((end (point)))
      (insert "https://example.com/ordinary\n")
      (gptel-ui-mode 1)
      (should (cl-some (lambda (ov) (overlay-get ov 'gptel-ui-table))
                      gptel-ui--overlays))
      (let ((native (make-overlay (point-min) end))
            (map (make-sparse-keymap))
            (tick (buffer-modified-tick)))
        (define-key map (kbd "C-c C-c") #'ignore)
        (overlay-put native 'keymap map)
        (overlay-put native 'gptel-tool '(pending))
        (gptel-ui-refresh)
        (should (= tick (buffer-modified-tick)))
        (should-not (cl-some (lambda (ov) (overlay-get ov 'gptel-ui-table))
                            gptel-ui--overlays))
        (goto-char (point-min))
        (search-forward "https://example.com/preview")
        (backward-char 2)
        (should-not (get-char-property (point) 'gptel-ui-link))
        (should (eq (key-binding (kbd "C-c C-c")) #'ignore))
        (goto-char end)
        (should (eq (key-binding (kbd "RET")) #'gptel-ui-links-open))
        (delete-overlay native)
        (gptel-ui-refresh)
        (should (= tick (buffer-modified-tick)))
        (should (cl-some (lambda (ov) (overlay-get ov 'gptel-ui-table))
                        gptel-ui--overlays))))))

(ert-deftest gptel-ui-render-approval-change-schedules-only-affected-buffer ()
  (gptel-ui-render-test--buffer
    (insert "https://example.com/preview\n")
    (gptel-ui-mode 1)
    (gptel-ui-refresh)
    (let* ((target (current-buffer))
           (position (copy-marker (point-max)))
           (info (list :position position))
           native)
      (gptel-ui-render-test--buffer
        (gptel-ui-mode 1)
        (gptel-ui-refresh)
        (should
         (eq (gptel-ui--render-approval-change
              (lambda (_calls context)
                (with-current-buffer (marker-buffer (plist-get context :position))
                  (setq native (make-overlay (point-min) (point-max)))
                  (overlay-put native 'gptel-tool '(pending)))
                'created)
              nil info)
             'created))
        (let ((timer (buffer-local-value 'gptel-ui--timer target)))
          (should (timerp timer))
          (should-not gptel-ui--timer)
          ;; Deletion loses the overlay's buffer; the wrapper captures it first.
          (should (eq (gptel-ui--render-approval-change
                       (lambda (_calls ov) (delete-overlay ov) 'deleted)
                       nil native)
                      'deleted))
          ;; Successive changes reuse one timer, without refreshing the caller.
          (should (eq timer (buffer-local-value 'gptel-ui--timer target)))
          (should-not gptel-ui--timer))
        (with-current-buffer target (gptel-ui-refresh))
        ;; Minibuffer approvals and other operations with unchanged intervals
        ;; must not schedule needless transcript rendering.
        (gptel-ui--render-approval-change #'ignore nil info)
        (should-not (buffer-local-value 'gptel-ui--timer target))
        (should-not gptel-ui--timer))
      (set-marker position nil))))

(ert-deftest gptel-ui-render-reused-tool-gap-does-not-accumulate ()
  (gptel-ui-render-test--buffer
    (insert "@assistant\n#+begin_tool Read\n")
    (insert (propertize "result\n" 'gptel '(tool . "read-1")))
    (insert "#+end_tool\n\n")
    (insert (propertize "[answer](a.el)\n" 'gptel 'response))
    (gptel-ui-mode 1)
    (let ((link (cl-find-if (lambda (ov) (overlay-get ov 'gptel-ui-links))
                            gptel-ui--overlays)))
      (should (equal (overlay-get link 'before-string) "\n\n"))
      (dotimes (_ 3) (gptel-ui-refresh))
      (should (overlay-buffer link))
      (should (equal (overlay-get link 'before-string) "\n\n"))
      (gptel-ui-render-test--matches-full))))

(ert-deftest gptel-ui-render-workspace-and-file-availability ()
  (let ((directory (make-temp-file "gptel-ui-render-" t)))
    (unwind-protect
        (gptel-ui-render-test--buffer
          (insert "`new-file.el`\n")
          (gptel-ui-mode 1)
          (with-temp-file (expand-file-name "new-file.el" directory) (insert "ok"))
          (setq default-directory directory)
          (gptel-ui-refresh)
          (should (cl-some (lambda (ov) (overlay-get ov 'gptel-ui-links))
                           gptel-ui--overlays))
          (delete-file (expand-file-name "new-file.el" directory))
          (cl-letf (((symbol-function 'called-interactively-p) (lambda (&rest _) t)))
            (gptel-ui-refresh))
          (should-not (cl-some (lambda (ov) (overlay-get ov 'gptel-ui-links))
                               gptel-ui--overlays)))
      (delete-directory directory t))))

(provide 'gptel-ui-render-test)
